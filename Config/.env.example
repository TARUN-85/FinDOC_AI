# Copy to Config/.env and fill in. Never commit Config/.env.

# --- Required for the default (Gemini) provider ---
GEMINI_API_KEY=

# --- LLM (generation) ---
LLM_PROVIDER=gemini
# gemini-2.5-flash is limited to existing users of that model; new projects should use a current model.
LLM_MODEL=gemini-3.8-flash
# LLM_TEMPERATURE=            # optional; blank = provider default

# --- Embeddings (configured separately from the LLM) ---
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001   # blank also falls back to this; gemini-embedding-2 is supported
EMBEDDING_DIMENSIONS=768

# --- Storage and retrieval ---
VECTOR_STORE=chroma
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
MIN_RELEVANCE=0.30

# --- Optional ---
# MAX_UPLOAD_MB=25
# LOG_LEVEL=INFO
